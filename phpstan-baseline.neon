parameters:
	ignoreErrors:
		-
			message: '#^PHPDoc tag @param for parameter \$item with type object is not subtype of native type CommonGLPI\.$#'
			identifier: parameter.phpDocType
			count: 2
			path: src/Entity.php

		-
			message: '#^Access to an undefined property CommonGLPI\:\:\$fields\.$#'
			identifier: property.notFound
			count: 1
			path: src/Profile.php

		-
			message: '#^Method GlpiPlugin\\Transferticketentity\\Profile\:\:getAllRights\(\) invoked with 1 parameter, 0 required\.$#'
			identifier: arguments.count
			count: 1
			path: src/Profile.php

		-
			message: '#^Method GlpiPlugin\\Transferticketentity\\Ticket\:\:showFormMcv\(\) with return type void returns false but should not return anything\.$#'
			identifier: return.void
			count: 4
			path: src/Ticket.php

		-
			message: '#^PHPDoc tag @param for parameter \$item with type object is not subtype of native type CommonGLPI\.$#'
			identifier: parameter.phpDocType
			count: 2
			path: src/Ticket.php
